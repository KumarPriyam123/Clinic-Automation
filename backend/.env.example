# ClinicQ backend — copy to .env and fill in. NEVER commit .env.

# --- Database / Supabase ---------------------------------------------------
# Long-running pool: use the Supabase POOLER DSN (host contains
# 'pooler.supabase.com', port 6543). Pooler => statement_cache_size auto-set to
# 0 and SSL auto-enabled (see app/db.py). For scripts/migrate.py prefer the
# DIRECT connection (port 5432).
DATABASE_URL=postgresql://user:pass@localhost:5432/clinicq
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Override the auto-detection only if needed:
# DB_STATEMENT_CACHE_SIZE=0   # force-disable prepared statements (pgBouncer)
# DB_SSL=true                 # force SSL 'require'

# --- WhatsApp Cloud API ----------------------------------------------------
WA_TOKEN=                 # PERMANENT system-user token (not the 24h temp one)
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=          # your choice; must match Meta webhook config
WA_APP_SECRET=            # Meta app secret; enables webhook signature check

# --- LLM (gemini-flash | claude-haiku) -------------------------------------
LLM_PROVIDER=gemini-flash
LLM_API_KEY=
# Model to call. Change here when a model is retired — no code change needed.
# List live models: curl "https://generativelanguage.googleapis.com/v1beta/models?key=KEY"
# Free-tier quota: gemini-3.1-flash-lite = 500 RPD / 15 RPM (sufficient for one clinic).
LLM_MODEL=gemini-3.1-flash-lite

# --- Auth / runtime --------------------------------------------------------
JWT_SECRET=dev-secret-change-me   # long random string in prod
ENV=dev

# --- Panel / CORS ----------------------------------------------------------
# Comma-separated origins allowed to call the API. Add your Vercel domain in prod.
# PANEL_ORIGINS=["https://clinicq-panel.vercel.app"]

# --- Scheduler single-instance guard ---------------------------------------
# APScheduler runs in-process. Exactly ONE process may set this true; keep
# uvicorn at --workers 1. Set false on any extra web process.
RUN_SCHEDULER=true

# --- Cloudflare Tunnel (docker-compose) ------------------------------------
TUNNEL_TOKEN=            # named-tunnel token from the Cloudflare dashboard
