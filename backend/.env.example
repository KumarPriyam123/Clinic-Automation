# ClinicQ backend — copy to .env and fill in. Never commit .env.

# Database / Supabase
DATABASE_URL=postgresql://user:pass@localhost:5432/clinicq
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# WhatsApp Cloud API
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# LLM (gemini-flash | claude-haiku)
LLM_PROVIDER=gemini-flash
LLM_API_KEY=

# Auth / runtime
JWT_SECRET=dev-secret-change-me
ENV=dev
