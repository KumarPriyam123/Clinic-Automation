# ClinicQ backend — PRODUCTION environment template.
#
# Copy to `.env` on the droplet and fill in real values. This file is the only
# versioned record of what production needs: the real `.env` lives solely on the
# droplet, is gitignored, and holds the permanent WhatsApp token, the JWT secret
# and the Supabase service key — so it can never be pasted anywhere to check.
#
# PLACEHOLDERS ONLY. Never commit a real value to this file.
#
# Every variable below is read by backend/app/config.py. After editing `.env`,
# run `docker compose up -d --force-recreate backend`: env_file is read when the
# container is CREATED, so editing .env under a running container changes
# nothing. (That exact trap left CORS broken in production for ~13 minutes while
# the file on disk already held the right value.)

# --- Database ---------------------------------------------------------------
# Supabase POOLER DSN in production (pgBouncer, transaction mode, port 6543).
# Not the direct 5432 DSN: the app runs one process with a small pool and the
# pooler is what Supabase expects for it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project REST URL and the SERVICE-ROLE key (bypasses RLS — secret).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# --- WhatsApp Cloud API -----------------------------------------------------
# PERMANENT system-user token, not the 24h dev token that expires overnight.
WA_TOKEN=<permanent-system-user-token>
# Numeric id of the sending number, from Meta > WhatsApp > API Setup.
WA_PHONE_NUMBER_ID=<phone-number-id>
# Any strong random string; must match exactly what is typed into Meta's
# webhook config or verification fails.
WA_VERIFY_TOKEN=<random-string>
# Meta app secret: EXACTLY 32 lowercase hex chars. Setting it enables webhook
# signature checking; leaving it blank disables that check (dev only).
# Startup logs an error if it is set but the wrong length.
WA_APP_SECRET=<32-hex-chars>

# --- LLM (free-text intent parsing only; never generates medical content) ----
# gemini-flash | claude-haiku
LLM_PROVIDER=gemini-flash
LLM_API_KEY=<provider-api-key>
# Model id is config, not code, so a retired model is a one-line fix.
LLM_MODEL=gemini-3.1-flash-lite

# --- Auth / runtime ---------------------------------------------------------
# Long random string. Rotating it invalidates every panel session.
JWT_SECRET=<long-random-string>

# `prod` or `production` switches on production boot checks — notably the
# refusal to start when PANEL_ORIGINS is unset. Any other value (including a
# typo) is treated as non-production and boots normally.
ENV=prod

# Bearer token guarding /metrics. LEAVE BLANK to keep /metrics disabled: unset
# makes the route 404 rather than serving cross-tenant counts publicly.
# /healthz stays open regardless — point uptime monitors there.
METRICS_TOKEN=

# --- CORS -------------------------------------------------------------------
# JSON ARRAY. Not a comma-separated string. This field is typed list[str], so
# pydantic-settings json-decodes it and `PANEL_ORIGINS=https://a,https://b`
# raises SettingsError at import time and the container never starts.
#
# Must list every origin the panel is served from. A missing origin fails inside
# the browser before any request is sent: no server log, no status code, and it
# reads to the clinic as "the PIN stopped working".
# In production this MUST be set — the app refuses to boot on the localhost
# defaults when ENV=prod.
PANEL_ORIGINS=["https://app.clinicq.kpriyam.me","https://<project>.vercel.app"]

# --- Scheduler --------------------------------------------------------------
# APScheduler runs in-process and must be ACTIVE in EXACTLY ONE process. With
# uvicorn --workers >1, or a second replica, every job double-fires and real
# patients get duplicate WhatsApp messages. Keep one replica, --workers 1.
RUN_SCHEDULER=true

# --- Database tuning (both auto-detected from the DSN; override only if needed)
# Force-disable asyncpg's prepared-statement cache. Required on the pooler,
# already auto-set to 0 when the DSN points at *.pooler.supabase.com.
DB_STATEMENT_CACHE_SIZE=
# Force SSL. Auto-enabled for Supabase DSNs.
DB_SSL=

# --- Cloudflare tunnel (consumed by docker-compose.yml, not by config.py) ----
# Token for the named tunnel that maps https://<subdomain> -> backend:8000.
# The droplet publishes no ports; the tunnel is how Meta reaches the webhook.
TUNNEL_TOKEN=<cloudflare-named-tunnel-token>
