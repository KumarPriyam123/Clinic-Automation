# Base URL of the ClinicQ backend (FastAPI). No trailing slash.
# The panel calls <this>/panel/* . Copy to .env.local for local dev.
#
# KEEP THIS POINTED AT LOCALHOST.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, and .env.local
# takes precedence over the shell environment in Next.js — so prefixing a command
# with NEXT_PUBLIC_API_URL=... does NOT override this file. If this holds a
# production URL, every local run talks to the live pilot clinic: real sessions,
# real patients, real WhatsApp sends. During P8 this pointed at production and
# local login probes reached the live backend before anyone noticed.
#
# The panel shows a red "PROD BACKEND" banner whenever it is served from
# localhost but configured with a remote API base. If you see it, fix .env.local.
#
# Leave unset entirely to use the same-origin /api proxy (see next.config.mjs).
NEXT_PUBLIC_API_URL=http://localhost:8000
